{
  "name": "blog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/blog/src",
  "prefix": "",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "outputs": ["{options.outputPath}"],
      "outputMode": "server",
      "options": {
        "outputPath": "dist/apps/blog",
        "index": "apps/blog/src/index.html",
        "browser": "apps/blog/src/main.ts",
        "server": "apps/blog/src/main.server.ts",
        "security": {
          "allowedHosts": [
            "localhost",
            "127.0.0.1",
            "binarycoffee.dev",
            "dev.binarycoffee.dev"
          ]
        },
        "ssr": {
          "entry": "apps/blog/src/server.ts"
        },
        "polyfills": ["zone.js"],
        "tsConfig": "apps/blog/tsconfig.app.json",
        "allowedCommonJsDependencies": ["moment", "xhr2"],
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/blog/src/favicon.png",
          "apps/blog/src/assets",
          {
            "glob": "*",
            "input": "libs/shared/src/assets",
            "output": "assets/"
          }
        ],
        "styles": [
          "apps/blog/src/styles.scss",
          "./node_modules/@angular/material/prebuilt-themes/purple-green.css",
          "node_modules/prismjs/themes/prism-okaidia.css",
          "node_modules/prismjs/plugins/line-numbers/prism-line-numbers.css",
          "node_modules/katex/dist/katex.min.css"
        ],
        "scripts": [
          "node_modules/prismjs/prism.js",
          "node_modules/prismjs/plugins/line-numbers/prism-line-numbers.js",
          "node_modules/katex/dist/katex.min.js",
          "node_modules/katex/dist/contrib/auto-render.min.js",
          "node_modules/prismjs/components/prism-css.min.js",
          "node_modules/prismjs/components/prism-csharp.min.js",
          "node_modules/prismjs/components/prism-java.js",
          "node_modules/prismjs/components/prism-javascript.js",
          "node_modules/prismjs/components/prism-go.js",
          "node_modules/prismjs/components/prism-php.js",
          "node_modules/prismjs/components/prism-typescript.js",
          "node_modules/prismjs/components/prism-yaml.js",
          "node_modules/prismjs/components/prism-sass.js",
          "node_modules/prismjs/components/prism-ruby.js",
          "node_modules/prismjs/components/prism-python.js",
          "node_modules/prismjs/components/prism-pascal.js",
          "node_modules/prismjs/components/prism-kotlin.js",
          "node_modules/prismjs/components/prism-c.js",
          "node_modules/prismjs/components/prism-bash.js",
          "node_modules/prismjs/components/prism-json.js",
          "node_modules/moment/min/moment.min.js",
          "node_modules/moment/locale/es.js"
        ]
      },
      "configurations": {
        "production": {
          "outputMode": "server",
          "security": {
            "allowedHosts": ["localhost", "127.0.0.1", "binarycoffee.dev"]
          },
          "fileReplacements": [
            {
              "replace": "apps/blog/src/environments/environment.ts",
              "with": "apps/blog/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3mb",
              "maximumError": "4mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "21kb"
            }
          ],
          "sourceMap": true,
          "outputHashing": "all",
          "optimization": true
        },
        "development": {
          "outputMode": "server",
          "security": {
            "allowedHosts": ["localhost", "127.0.0.1", "dev.binarycoffee.dev"]
          },
          "fileReplacements": [
            {
              "replace": "apps/blog/src/environments/environment.ts",
              "with": "apps/blog/src/environments/environment.dev.ts"
            }
          ],
          "optimization": false,
          "outputHashing": "all",
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "default": {
          "outputMode": "server",
          "security": {
            "allowedHosts": ["localhost", "127.0.0.1"]
          },
          "optimization": false,
          "outputHashing": "all",
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "default"
    },
    "serve-ssr": {
      "executor": "@nx/angular:dev-server",
      "continuous": true,
      "security": {
        "allowedHosts": ["*"]
      },
      "options": {
        "port": 4200,
        "host": "0.0.0.0",
        "buildTarget": "blog:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "blog:build:production"
        },
        "development": {
          "buildTarget": "blog:build:development"
        },
        "default": {
          "buildTarget": "blog:build"
        }
      },
      "defaultConfiguration": "default"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "continuous": true,
      "options": {
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "blog:build:production"
        },
        "development": {
          "buildTarget": "blog:build:development"
        },
        "default": {
          "buildTarget": "blog:build:default"
        }
      },
      "defaultConfiguration": "default"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/blog/jest.config.js",
        "tsConfig": "apps/blog/tsconfig.spec.json"
      }
    }
  }
}
